# Copy to .env for local (non-Docker) development: cp .env.example .env
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgresql://carrierchaos:carrierchaos@localhost:5432/carrierchaos?connection_limit=20
# Used only by the integration test suite.
TEST_DATABASE_URL=postgresql://carrierchaos:carrierchaos@localhost:5432/carrierchaos_test
TEST_REDIS_URL=redis://localhost:6379/15
REDIS_URL=redis://localhost:6379
MOCK_CARRIER_URL=http://localhost:4000

# Development-only shared secret for administrative endpoints (see README "Authentication").
ADMIN_TOKEN=dev-admin-token

API_PORT=3000
WORKER_METRICS_PORT=9464
MOCK_CARRIER_PORT=4000

# Per-carrier worker concurrency (each carrier has its own queue and worker pool).
WORKER_CONCURRENCY=8
CARRIER_REQUEST_TIMEOUT_MS=2000

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=8000
RETRY_MAX_RETRY_AFTER_MS=30000
JOB_DEADLINE_MS=600000

BREAKER_FAILURE_RATE_THRESHOLD=0.5
BREAKER_MINIMUM_REQUESTS=10
BREAKER_WINDOW_MS=10000
BREAKER_OPEN_DURATION_MS=5000
BREAKER_HALF_OPEN_MAX_PROBES=2
BREAKER_HALF_OPEN_SUCCESS_THRESHOLD=2

{
  "name": "carrierchaos",
  "version": "1.0.0",
  "private": true,
  "description": "Third-party integration reliability engine: queue-based insurance carrier retrieval with fault injection, retries, circuit breaking, rate limiting and reproducible experiments.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:mock": "tsx watch src/mock-carrier/main.ts",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:mock": "node dist/mock-carrier/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "experiments": "tsx scripts/run-experiments.ts",
    "load-test": "tsx scripts/load-test.ts",
    "demo": "bash scripts/demo.sh",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "bullmq": "5.81.5",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
